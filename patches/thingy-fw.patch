+/**@brief Restores the LED state that applies while the button is not held.
+ */
+static ret_code_t led_restore(void)
+{
+    if (m_uis.conn_handle != BLE_CONN_HANDLE_INVALID)
+    {
+        return led_set(mp_config_ui, NULL);
+    }
+
+    return m_ui_led_set_event(M_UI_BLE_DISCONNECTED);
+}
+
+
+/**@brief Keeps the lightwell LED lit while the button is held.
+ *
+ * @details Bypasses the BLE LED configuration so the light comes on even when the LED is configured as off.
+ */
+static ret_code_t led_button_hold(uint8_t button_action)
+{
+    ret_code_t                                  err_code;
+    static const drv_ext_light_rgb_intensity_t  hold_color = UI_BUTTON_HOLD_COLOR;
+
+    if (button_action != APP_BUTTON_PUSH)
+    {
+        return led_restore();
+    }
+
+    err_code = drv_ext_light_off(DRV_EXT_RGB_LED_LIGHTWELL);
+    RETURN_IF_ERROR(err_code);
+
+    return drv_ext_light_rgb_intensity_set(DRV_EXT_RGB_LED_LIGHTWELL, &hold_color);
+}
+
+
 static void button_evt_handler(uint8_t pin_no, uint8_t button_action)
 {
     uint32_t err_code;
 
     if (pin_no == BUTTON)
     {
+        err_code = led_button_hold(button_action);
+        APP_ERROR_CHECK(err_code);
+
+
         //If Thingy is connected to a Central.
         if (m_uis.conn_handle != BLE_CONN_HANDLE_INVALID)
         {
